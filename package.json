{
  "name": "peripheral-agentic-os",
  "version": "2.0.0",
  "description": "The first application-layer operating system for universal AI agent orchestration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "paos": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "serve": "tsx src/index.ts --serve",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "dashboard": "cd dashboard && npm run dev",
    "dashboard:build": "cd dashboard && npm run build",
    "iso": "sudo bash iso/build-iso.sh"
  },
  "keywords": [
    "ai-agents",
    "multi-agent-systems",
    "agent-orchestration",
    "llm",
    "operating-system"
  ],
  "license": "Elastic-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "commander": "^12.1.0",
    "better-sqlite3": "^11.6.0",
    "ws": "^8.18.0",
    "yaml": "^2.6.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0",
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/ws": "^8.5.12",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "vitest": "^2.1.0"
  }
}
